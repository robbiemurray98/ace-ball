</head>
<body>
    <div id="container">
        <%= require('./partials/header.html') %>

        <!-- create hero image -->
        <div id="how-to-play-hero-container">
            <img src="images/play-3.jpg" alt="" id="how-to-play-hero">
            <h1>How <br>to <br>play</h1>
        </div>
